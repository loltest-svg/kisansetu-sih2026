# Environment variable placeholders — Phase 1 foundation only.
#
# No real values are set here. Supabase is not configured in this phase
# (docs/PROJECT_STATE.md) — these names are documented ahead of time so
# Phase 2 has an agreed shape to fill in, not because anything reads them
# yet. Copy to .env.local (git-ignored) when Supabase setup begins.

# Public — safe to expose to the browser (anon key only, never service role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefixed with NEXT_PUBLIC_, never sent to the client
# (docs/SECURITY.md — secret/environment handling)
SUPABASE_SERVICE_ROLE_KEY=
